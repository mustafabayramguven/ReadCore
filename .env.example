# GHCR repository paths are lowercase; use the actual image published by Actions.
READCORE_IMAGE=ghcr.io/your-github-user/readcore-server:latest
READCORE_TOKEN=replace-with-a-long-random-secret
READCORE_BOOKS_DIR=/absolute/path/to/books
READCORE_PORT=8080

# Required only with docker-compose.https.yml; point public DNS here first.
READCORE_DOMAIN=books.example.com
